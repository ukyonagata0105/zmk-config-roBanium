#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/rgbled_widget.dtsi>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "balanced";
    quick-tap-ms = <200>;
    tapping-term-ms = <200>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <150>;
    tapping-term-ms = <150>;
};

&trackball {
    // オートマウスレイヤー（AML）を使用するため、scroll-layersは無効化
    // AMLの設定はroBa_R.overlayで行っています
    // scroll-layers = <5>;

    // Layer 3でトラックボール操作を矢印キー入力に変換
    arrows {
        layers = <3>;
        bindings =
            <&kp RIGHT_ARROW>,
            <&kp LEFT_ARROW>,
            <&kp UP_ARROW>,
            <&kp DOWN_ARROW>;
        tick = <10>;
        wait-ms = <5>;
        tap-ms = <5>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        // 左手コンボ: X + C = Z
        combo_z {
            bindings = <&kp Z>;
            key-positions = <22 23>;  // X + C (3行目の0番目と1番目)
            timeout-ms = <50>;
        };

        // カッコ自動補完コンボ（右手ホーム 隣接キー）
        // キー位置: H=15, T=16, N=17, S=18, K=19
        combo_paren {
            bindings = <&paren_pair>;
            key-positions = <16 17>;  // T + N
            timeout-ms = <50>;
        };

        combo_brace {
            bindings = <&brace_pair>;
            key-positions = <17 18>;  // N + S
            timeout-ms = <50>;
        };

        combo_bracket_jp {
            bindings = <&bracket_jp>;
            key-positions = <18 19>;  // S + K
            timeout-ms = <50>;
        };

        // 記号はLayer 1に移行（コンボは削除）

        // プログラミング用記号コンボ
        arrow {
            bindings = <&arrow_macro>;
            key-positions = <19 20>;  // K + -
        };

        fat_arrow {
            bindings = <&fat_arrow_macro>;
            key-positions = <18 20>;  // S + -
        };

        not_equal {
            bindings = <&not_equal_macro>;
            key-positions = <16 19>;  // T + K
        };

        equal_equal {
            bindings = <&equal_equal_macro>;
            key-positions = <15 18>;  // H + S
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // カッコ自動補完マクロ
        paren_pair: paren_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "PAREN_PAIR";
        };

        brace_pair: brace_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
            label = "BRACE_PAIR";
        };

        bracket_jp: bracket_jp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LBKT) &kp LS(RBKT) &kp LEFT>;
            label = "BRACKET_JP";
        };

        // プログラミング用記号マクロ
        arrow_macro: arrow_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "ARROW";
        };

        fat_arrow_macro: fat_arrow_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "FAT_ARROW";
        };

        not_equal_macro: not_equal_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EXCL &kp EQUAL>;
            label = "NOT_EQUAL";
        };

        equal_equal_macro: equal_equal_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp EQUAL>;
            label = "EQUAL_EQUAL";
        };
    };

    behaviors {
        // J長押し1秒で@
        j_at: j_at {
            compatible = "zmk,behavior-hold-tap";
            label = "J_AT";
            flavor = "tap-preferred";
            tapping-term-ms = <1000>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
        };

        // 伸ばし棒長押しでTAB
        tab_minus: tab_minus {
            compatible = "zmk,behavior-hold-tap";
            label = "TAB_MINUS";
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
        };

        lt_hold: lt_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_HOLD";
            flavor = "hold-preferred";
            quick-tap-ms = <150>;
            tapping-term-ms = <150>;
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        // 数字キー長押しで記号入力
        num_sym: num_sym {
            compatible = "zmk,behavior-hold-tap";
            label = "NUM_SYM";
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
        };

        // Backspace長押しでブラウザ戻る
        bspc_back: bspc_back {
            compatible = "zmk,behavior-hold-tap";
            label = "BSPC_BACK";
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mkp>, <&kp>;
            #binding-cells = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: ベースレイヤー（五十音順配列・最適化版）
        // レイヤー切り替え: 左手上段(F1-F4)=L1/2/3/4、右手右列(L/H/P/.)=L1/2/3/4（上から）
        // 左手: 母音（A I U E O）+ ファンクションキー（上段）+ 親指エリアにマウスボタン
        // 右手: 使用頻度高い子音（ま や ら わ / か さ た な は / 濁音・半濁音）
        // コンボ: X+C = Z
        // J長押し1秒: @
        // ー長押し200ms: TAB
        // F1/L1 F2/L2 F3/L3 F4/L4 F5                  M  Y  R  W  L/L1
        // A  I  U  E  O  [MB3]     [BSPC]            K  S  T  N  H/L2
        // X C V Q F J/@  [ー/TAB]                    G  Z  D  B  P/L3
        // , ESC/Alt LANG2/Ctrl LANG1/Cmd [MB2] [MB1]  [SPACE]  Enter/L2  ./Ctrl+Up
        default_layer {
            bindings = <
&lt 1 F1                    &lt 2 F2          &lt 3 F3         &lt 4 F4                &kp F5                                                &kp M           &kp Y       &kp R     &kp W            &lt 1 L
&kp A                       &kp I             &kp U            &kp E                   &kp O             &mkp MB3        &kp BACKSPACE       &kp K           &kp S       &kp T     &kp N            &lt 2 H
&kp X                       &kp C             &kp V            &kp Q                   &kp F             &j_at AT_SIGN J &tab_minus TAB MINUS &kp G          &kp Z       &kp D     &kp B            &lt 3 P
&kp COMMA                   &mt LEFT_ALT ESC  &mt LCTRL LANG2  &mt LEFT_COMMAND LANG1  &mkp MB2          &mkp MB1        &kp SPACE           &lt 2 ENTER                                        &mt LC(UP) DOT
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        // Layer 1: 矢印キー + テンキー + 記号
        // 左側: 矢印キー配置、右側: テンキー（1-9配置）+ 記号
        // 数字長押しで記号: 1!  2@  3#  4$  5%  6^  7&  8*  9(  0)
        // 右下: -（マイナス）? !
        layer_1 {
            bindings = <
&trans        &trans        &kp UP        &trans        &trans                                          &num_sym EXCL N1      &num_sym AT N2       &num_sym HASH N3     &kp SLASH       &trans
&trans        &kp LEFT      &kp DOWN      &kp RIGHT     &trans        &trans          &kp BACKSLASH     &num_sym DOLLAR N4    &num_sym PERCENT N5  &num_sym CARET N6    &kp ASTERISK    &kp COLON
&trans        &trans        &trans        &trans        &trans        &trans          &trans            &num_sym AMPS N7      &num_sym ASTERISK N8 &num_sym LPAR N9     &kp MINUS       &kp QUESTION
&trans        &trans        &trans        &trans        &trans        &trans          &trans            &num_sym RPAR N0                                                                   &kp EXCL
            >;

            sensor-bindings = <&inc_dec_kp LG(MINUS) LG(PLUS)>;
        };

        // Layer 2: ファンクションキー + VSCodeショートカット
        layer_2 {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                            &kp LC(P)      &kp LC(LS(P))      &kp LC(B)           &kp LC(GRAVE)       &trans
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &trans           &trans  &kp LA(LG(H))  &kp LC(LEFT_ARROW)  &kp LC(UP_ARROW)    &kp LC(RIGHT_ARROW)  &trans
&kp F11  &kp F12  &trans  &trans  &trans   &trans           &trans  &kp LA(LG(L))  &kp LG(LEFT_BRACKET)  &kp LC(DOWN_ARROW)  &kp LG(RIGHT_BRACKET)  &trans
&trans   &trans   &trans  &trans  &trans   &kp LS(TAB)      &trans  &trans                                                                        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        // Layer 3: ターミナル/システムショートカット
        layer_3 {
            bindings = <
&kp LC(C)  &kp LC(Z)  &kp LC(D)  &kp LC(L)  &trans                      &trans  &trans           &trans       &kp LS(LA(F))             &trans
&trans     &trans     &trans     &trans     &trans  &trans      &trans  &trans  &kp LS(LC(TAB))  &kp LC(TAB)  &kp LS(LC(LG(NUMBER_4)))  &trans
&trans     &trans     &trans     &trans     &trans  &trans      &trans  &trans  &trans           &kp LG(W)    &trans                    &trans
&trans     &trans     &trans     &trans     &trans  &trans      &trans  &trans                                                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(LS(TAB)) LC(TAB)>;
        };

        // Layer 4: Bluetooth設定 + OS切り替え
        // Bluetoothプロファイル0-4を使い分けることで、異なるOSに接続できます
        // 例: プロファイル0=Windows、プロファイル1=Mac など
        // OSごとに異なる修飾キーマッピングが必要な場合は、レイヤー2-3で対応
        // &ind_bat: バッテリー残量確認（LED: 緑80%以上、黄20-79%、赤1-19%）
        layer_4 {
            bindings = <
&trans    &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4
&ind_bat  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans          &trans          &trans        &trans
&trans    &trans  &trans  &trans  &trans  &trans      &trans  &trans        &bt BT_CLR      &bt BT_CLR_ALL  &bt BT_PRV    &bt BT_NXT    
&trans    &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                      &trans
            >;
        };

        // Layer 5: スクロール（トラックボール用）
        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
