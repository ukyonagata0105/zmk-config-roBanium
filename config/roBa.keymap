#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/rgbled_widget.dtsi>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "balanced";
    quick-tap-ms = <150>;
    tapping-term-ms = <150>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <150>;
    tapping-term-ms = <150>;
};

&trackball {
    // オートマウスレイヤー（AML）を使用するため、scroll-layersは無効化
    // AMLの設定はroBa_R.overlayで行っています
    // scroll-layers = <5>;

    // Layer 3でトラックボール操作を矢印キー入力に変換
    arrows {
        layers = <3>;
        bindings =
            <&kp RIGHT_ARROW>,
            <&kp LEFT_ARROW>,
            <&kp UP_ARROW>,
            <&kp DOWN_ARROW>;
        tick = <10>;
        wait-ms = <5>;
        tap-ms = <5>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        // カッコ自動補完コンボ（右手ホーム 隣接キー）
        // キー位置: H=15, T=16, N=17, S=18, K=19
        combo_paren {
            bindings = <&paren_pair>;
            key-positions = <16 17>;  // T + N
            timeout-ms = <50>;
        };

        combo_brace {
            bindings = <&brace_pair>;
            key-positions = <17 18>;  // N + S
            timeout-ms = <50>;
        };

        combo_bracket_jp {
            bindings = <&bracket_jp>;
            key-positions = <18 19>;  // S + K
            timeout-ms = <50>;
        };

        // 記号はLayer 1に移行（コンボは削除）

        // プログラミング用記号コンボ
        arrow {
            bindings = <&arrow_macro>;
            key-positions = <19 20>;  // K + -
        };

        fat_arrow {
            bindings = <&fat_arrow_macro>;
            key-positions = <18 20>;  // S + -
        };

        not_equal {
            bindings = <&not_equal_macro>;
            key-positions = <16 19>;  // T + K
        };

        equal_equal {
            bindings = <&equal_equal_macro>;
            key-positions = <15 18>;  // H + S
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // カッコ自動補完マクロ
        paren_pair: paren_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "PAREN_PAIR";
        };

        brace_pair: brace_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
            label = "BRACE_PAIR";
        };

        bracket_jp: bracket_jp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LBKT) &kp LS(RBKT) &kp LEFT>;
            label = "BRACKET_JP";
        };

        // プログラミング用記号マクロ
        arrow_macro: arrow_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "ARROW";
        };

        fat_arrow_macro: fat_arrow_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "FAT_ARROW";
        };

        not_equal_macro: not_equal_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EXCL &kp EQUAL>;
            label = "NOT_EQUAL";
        };

        equal_equal_macro: equal_equal_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp EQUAL>;
            label = "EQUAL_EQUAL";
        };
    };

    behaviors {
        lt_hold: lt_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_HOLD";
            flavor = "hold-preferred";
            quick-tap-ms = <150>;
            tapping-term-ms = <150>;
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        // 数字キー長押しで記号入力
        num_sym: num_sym {
            compatible = "zmk,behavior-hold-tap";
            label = "NUM_SYM";
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
        };

        // Backspace長押しでブラウザ戻る
        bspc_back: bspc_back {
            compatible = "zmk,behavior-hold-tap";
            label = "BSPC_BACK";
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mkp>, <&kp>;
            #binding-cells = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: ベースレイヤー（Tomisuke風配列）
        // レイヤー切り替え: 左手下段(Z/X/C/V)=L1/2/3/4、右手右列(;/K///.))=L1/2/3/4（上から）
        // Q  W  D  R  F                         J  L  P  Y  ;/L1
        // A  E  I  O  U  [MB3]    [BSPC/MB4]  H  T  N  S  K/L2
        // Z/L1 X/L2 C/L3 V/L4 B  [@]  [+]     M  G  [MB1] [MB2] //L3
        default_layer {
            bindings = <
&kp Q                       &kp W             &kp D            &kp R                   &kp F                                                             &kp J           &kp L       &kp P     &kp Y            &lt 1 SEMI
&mt LCTRL A                 &kp E             &kp I            &kp O                   &kp U             &mkp MB3                &bspc_back MB4 BACKSPACE  &kp H           &kp T       &kp N     &kp S            &lt 2 K
&lt 1 Z                     &lt 2 X           &lt 3 C          &lt 4 V                 &kp B             &kp AT_SIGN             &lt 4 PLUS                &kp M           &kp G       &mkp MB1  &mkp MB2         &lt 3 SLASH
&mt LC(LEFT_COMMAND) COMMA  &mt LEFT_ALT ESC  &mt LCTRL LANG2  &mt LEFT_COMMAND LANG1  &kp SPACE         &mt LEFT_SHIFT TAB      &kp LC(UP)                &lt 2 ENTER                                        &lt 4 DOT
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        // Layer 1: 矢印キー + テンキー + 記号
        // 左側: 矢印キー配置、右側: テンキー（1-9配置）+ 記号
        // 数字長押しで記号: 1!  2@  3#  4$  5%  6^  7&  8*  9(  0)
        layer_1 {
            bindings = <
&trans        &trans        &kp UP        &trans        &trans                                          &num_sym EXCL N1      &num_sym AT N2       &num_sym HASH N3     &kp SLASH       &trans
&trans        &kp LEFT      &kp DOWN      &kp RIGHT     &trans        &trans          &kp BACKSLASH     &num_sym DOLLAR N4    &num_sym PERCENT N5  &num_sym CARET N6    &kp ASTERISK    &kp COLON
&trans        &trans        &trans        &trans        &trans        &trans          &trans            &num_sym AMPS N7      &num_sym ASTERISK N8 &num_sym LPAR N9     &kp MINUS       &trans
&trans        &trans        &trans        &trans        &trans        &trans          &trans            &num_sym RPAR N0                                                                   &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(MINUS) LG(PLUS)>;
        };

        // Layer 2: ファンクションキー + VSCodeショートカット
        layer_2 {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                            &kp LC(P)      &kp LC(LS(P))      &kp LC(B)           &kp LC(GRAVE)       &trans
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &trans           &trans  &kp LA(LG(H))  &kp LC(LEFT_ARROW)  &kp LC(UP_ARROW)    &kp LC(RIGHT_ARROW)  &trans
&kp F11  &kp F12  &trans  &trans  &trans   &trans           &trans  &kp LA(LG(L))  &kp LG(LEFT_BRACKET)  &kp LC(DOWN_ARROW)  &kp LG(RIGHT_BRACKET)  &trans
&trans   &trans   &trans  &trans  &trans   &kp LS(TAB)      &trans  &trans                                                                        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        // Layer 3: ターミナル/システムショートカット
        layer_3 {
            bindings = <
&kp LC(C)  &kp LC(Z)  &kp LC(D)  &kp LC(L)  &trans                      &trans  &trans           &trans       &kp LS(LA(F))             &trans
&trans     &trans     &trans     &trans     &trans  &trans      &trans  &trans  &kp LS(LC(TAB))  &kp LC(TAB)  &kp LS(LC(LG(NUMBER_4)))  &trans
&trans     &trans     &trans     &trans     &trans  &trans      &trans  &trans  &trans           &kp LG(W)    &trans                    &trans
&trans     &trans     &trans     &trans     &trans  &trans      &trans  &trans                                                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(LS(TAB)) LC(TAB)>;
        };

        // Layer 4: Bluetooth設定 + OS切り替え
        // Bluetoothプロファイル0-4を使い分けることで、異なるOSに接続できます
        // 例: プロファイル0=Windows、プロファイル1=Mac など
        // OSごとに異なる修飾キーマッピングが必要な場合は、レイヤー2-3で対応
        // &ind_bat: バッテリー残量確認（LED: 緑80%以上、黄20-79%、赤1-19%）
        layer_4 {
            bindings = <
&trans    &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4
&ind_bat  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans          &trans          &trans        &trans
&trans    &trans  &trans  &trans  &trans  &trans      &trans  &trans        &bt BT_CLR      &bt BT_CLR_ALL  &bt BT_PRV    &bt BT_NXT    
&trans    &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                      &trans
            >;
        };

        // Layer 5: スクロール（トラックボール用）
        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
